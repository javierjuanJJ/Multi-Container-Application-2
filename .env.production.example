# Copia este archivo a .env.production en el servidor (NO lo subas a git).
# Ansible lo genera desde el vault; el CI lo inyecta desde los secrets de GitHub.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Imagen publicada por GitHub Actions. Debe incluir la etiqueta exacta del commit.
API_IMAGE=YOUR_DOCKERHUB_USER/todos-api:latest

# --- MongoDB ---------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=cambia-esta-contrasena-por-una-larga-y-aleatoria
MONGO_DATABASE=todos
MONGO_VOLUME_NAME=todos-mongo-data

# --- Puertos publicados por el reverse proxy --------------------------------
HTTP_PORT=80
HTTPS_PORT=443