# Copia este archivo a .env.production en el servidor (NO lo subas a git).
# Ansible lo genera desde el vault; el CI lo inyecta desde los secrets de GitHub.
#
#   ./scripts/blue-green.sh deploy YOUR_USER/todos-api:sha-abc123
#
# OJO: la forma correcta de levantar el stack de produccion es el script
# blue-green.sh (o el pipeline CD / el rol de Ansible), no un `docker compose
# up` directo: el script es quien elige el color, espera al healthcheck y
# conmuta el trafico.

# Ultima imagen publicada. La usa blue-green.sh como valor por defecto cuando
# aun no hay ningun contenedor corriendo en un color.
API_IMAGE=YOUR_DOCKERHUB_USER/todos-api:latest

# Imagen de cada color (blue / green). Las escribe y mantiene blue-green.sh:
# cada despliegue solo cambia la del color inactivo, y el activo conserva la
# que ahora mismo recibe trafico. No las edites a mano.
# API_IMAGE_BLUE=YOUR_DOCKERHUB_USER/todos-api:sha-abc123
# API_IMAGE_GREEN=YOUR_DOCKERHUB_USER/todos-api:sha-9ef012

# --- MongoDB ---------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=cambia-esta-contrasena-por-una-larga-y-aleatoria
MONGO_DATABASE=todos
MONGO_VOLUME_NAME=todos-mongo-data

# --- Puertos publicados por el reverse proxy --------------------------------
HTTP_PORT=80
HTTPS_PORT=443
