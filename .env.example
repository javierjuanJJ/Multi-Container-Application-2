# Copia este archivo a .env y ajusta los valores.
# docker compose lo lee automaticamente para interpolar ${...} de docker-compose.yml.
# .env esta en .gitignore: no subas credenciales al repositorio.

# --- API -------------------------------------------------------------------
# Puerto del host donde se publica la API (requisito #1: http://localhost:3000)
API_PORT=3000

# Puerto del host para el perfil de desarrollo con nodemon
API_DEV_PORT=3001

# Etiqueta de la imagen que construye compose en local
API_IMAGE=todos-api:local

# --- MongoDB ---------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=todos-dev-password
MONGO_DATABASE=todos

# Volumen nombrado donde se persisten los documentos
MONGO_VOLUME_NAME=todos-mongo-data