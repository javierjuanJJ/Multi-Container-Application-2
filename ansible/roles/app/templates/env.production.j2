# Generado por Ansible (rol `app`). No editar en el servidor: vive en el repositorio.
#
# API_IMAGE es la ultima imagen publicada. Las claves por color
# (API_IMAGE_BLUE / API_IMAGE_GREEN) las añade y mantiene blue-green.sh a
# partir de lo que ya esta corriendo: cada despliegue solo cambia la del
# color inactivo, y el activo conserva la que sirve trafico.
API_IMAGE={{ app_image }}

MONGO_ROOT_USERNAME={{ app_mongo_username }}
MONGO_ROOT_PASSWORD={{ app_mongo_password }}
MONGO_DATABASE={{ app_mongo_database }}
MONGO_VOLUME_NAME={{ app_mongo_volume_name }}

HTTP_PORT={{ app_http_port }}
HTTPS_PORT={{ app_https_port }}